<Window x:Class="SupabaseDBManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supabase 数据库管理工具 v1.0.4" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 连接配置 -->
            <RowDefinition Height="*"/>
            <!-- 主内容 -->
            <RowDefinition Height="Auto"/>
            <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 连接配置区域 -->
        <GroupBox Header="数据库连接配置" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" FontWeight="Bold" Foreground="#333"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- URL 行 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBox x:Name="SupabaseUrlTextBox" Grid.Row="0" Grid.Column="1"
                         Text="https://xxx.supabase.co" Margin="0,0,10,10"
                         Height="28" VerticalContentAlignment="Center" FontSize="12"/>

                <!-- Connection String 行 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Connection String:" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Bold" Margin="0,0,10,0"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ConnectionStringPasswordBox" Grid.Column="0"
                                 Height="28" VerticalContentAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="1" Content="👁️" Width="45" Margin="5,0,0,0"
                            Click="OnToggleConnectionStringVisibilityClick" ToolTip="显示/隐藏密码"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="TestConnectionButton" Content="🔗 测试连接"
                            Width="110" Height="28" Click="OnTestConnectionClick"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="SaveConfigButton" Content="💾 保存配置"
                            Width="110" Height="28" Click="OnSaveConfigClick"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 主内容区域 -->
        <TabControl Grid.Row="1" Background="White" x:Name="MainTabControl">
            <!-- Tables 标签页 -->
            <TabItem Header="Tables" FontSize="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 表列表 -->
                    <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 搜索框 -->
                            <TextBox x:Name="TableSearchTextBox" Grid.Row="0"
                                     Height="28" Margin="8" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnTableSearchTextChanged"
                                     ToolTip="搜索表名"/>

                            <!-- 表列表 -->
                            <TreeView x:Name="TablesTreeView" Grid.Row="1" Margin="8,0,8,8"
                                      BorderThickness="1" BorderBrush="#DDD"
                                      SelectedItemChanged="OnTablesTreeViewSelectedItemChanged"/>
                        </Grid>
                    </Border>

                    <!-- 表详情 -->
                    <Grid Grid.Column="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 表信息 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="TableNameTextBlock" Text="请选择一个表"
                                       FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock x:Name="TableInfoTextBlock" Text=""
                                       FontSize="11" Foreground="#666" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="📊 显示表结构" Width="120" Height="28" Margin="0,0,5,0"
                                    Click="OnShowTableStructureClick" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="📋 复制 DDL" Width="120" Height="28" Margin="0,0,5,0"
                                    Click="OnCopyTableDdlClick" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="📄 查看数据" Width="120" Height="28"
                                    Click="OnViewTableDataClick" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <!-- 列信息 -->
                        <GroupBox Grid.Row="2" Header="列信息" Margin="0,0,0,10" Padding="8">
                            <DataGrid x:Name="ColumnsDataGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      Background="White" BorderBrush="#DDD" BorderThickness="1"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="列名" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="100"/>
                                    <DataGridCheckBoxColumn Header="可空" Binding="{Binding IsNullable}" Width="50"/>
                                    <DataGridCheckBoxColumn Header="主键" Binding="{Binding IsPrimaryKey}" Width="50"/>
                                    <DataGridCheckBoxColumn Header="外键" Binding="{Binding IsForeignKey}" Width="50"/>
                                    <DataGridTextColumn Header="默认值" Binding="{Binding DefaultValue}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- DDL 预览 -->
                        <GroupBox Grid.Row="3" Header="DDL 预览" Padding="8">
                            <TextBox x:Name="TableDdlTextBox" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" Background="#FAFAFA"
                                     Text="选择一个表后，点击 '显示表结构' 查看完整 DDL"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Policies 标签页 -->
            <TabItem Header="Policies" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnRefreshPoliciesClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="📋 复制选中 DDL" Width="120" Height="28"
                                Click="OnCopyPolicyDdlClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <DataGrid x:Name="PoliciesDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              BorderBrush="#DDD" BorderThickness="1" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="策略名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="表" Binding="{Binding TableName}" Width="150"/>
                            <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="80"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding PolicyType}" Width="90"/>
                            <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Triggers 标签页 -->
            <TabItem Header="Triggers" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnRefreshTriggersClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="📋 复制选中 DDL" Width="120" Height="28" Margin="0,0,5,0"
                                Click="OnCopyTriggerDdlClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="📋 复制触发器+函数 DDL" Width="160" Height="28"
                                Click="OnCopyTriggerWithFunctionDdlClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <DataGrid x:Name="TriggersDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              BorderBrush="#DDD" BorderThickness="1" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="触发器名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="表" Binding="{Binding TableName}" Width="150"/>
                            <DataGridTextColumn Header="时机" Binding="{Binding Timing}" Width="80"/>
                            <DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="100"/>
                            <DataGridCheckBoxColumn Header="行级" Binding="{Binding IsRowLevel}" Width="50"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                            <DataGridTextColumn Header="函数" Binding="{Binding FunctionName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Indexes 标签页 -->
            <TabItem Header="Indexes" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnRefreshIndexesClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="📋 复制选中 DDL" Width="120" Height="28"
                                Click="OnCopyIndexDdlClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <DataGrid x:Name="IndexesDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              BorderBrush="#DDD" BorderThickness="1" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="索引名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="表" Binding="{Binding TableName}" Width="150"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding IndexType}" Width="80"/>
                            <DataGridCheckBoxColumn Header="唯一" Binding="{Binding IsUnique}" Width="50"/>
                            <DataGridCheckBoxColumn Header="主键" Binding="{Binding IsPrimaryKey}" Width="50"/>
                            <DataGridTextColumn Header="列" Binding="{Binding ColumnsText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Functions 标签页 -->
            <TabItem Header="Functions" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnRefreshFunctionsClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="📋 复制选中 DDL" Width="120" Height="28"
                                Click="OnCopyFunctionDdlClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="函数定义" Margin="0,0,0,10" Padding="8">
                        <TextBox x:Name="FunctionDefinitionTextBox" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" Background="#FAFAFA"
                                 Height="150" Text="选择一个函数后，显示其定义"/>
                    </GroupBox>

                    <DataGrid x:Name="FunctionsDataGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              BorderBrush="#DDD" BorderThickness="1" FontSize="12"
                              SelectionChanged="OnFunctionsDataGridSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="函数名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="返回类型" Binding="{Binding ReturnType}" Width="150"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding FunctionType}" Width="90"/>
                            <DataGridTextColumn Header="语言" Binding="{Binding Language}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Views 标签页 -->
            <TabItem Header="Views" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnRefreshViewsClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="📋 复制选中 DDL" Width="120" Height="28"
                                Click="OnCopyViewDdlClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <DataGrid x:Name="ViewsDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              BorderBrush="#DDD" BorderThickness="1" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="视图名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="架构" Binding="{Binding Schema}" Width="120"/>
                            <DataGridCheckBoxColumn Header="物化" Binding="{Binding IsMaterialized}" Width="60"/>
                            <DataGridTextColumn Header="列数" Binding="{Binding ColumnCount}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- SQL Query 标签页 -->
            <TabItem Header="SQL Query" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="▶️ 执行查询" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnExecuteQueryClick" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="📋 复制结果" Width="110" Height="28" Margin="0,0,5,0"
                                Click="OnCopyQueryResultsClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="🗑️ 清空" Width="80" Height="28"
                                Click="OnClearQueryClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="SQL 编辑器" Padding="8">
                        <TextBox x:Name="SqlEditorTextBox"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Background="White"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 Text="-- 在此输入 SQL 查询&#x0a;SELECT * FROM public.your_table LIMIT 100;"/>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="查询结果" Padding="8">
                        <DataGrid x:Name="QueryResultsDataGrid"
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" Background="White"
                                  BorderBrush="#DDD" BorderThickness="1" FontSize="12"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Data Editor 标签页 -->
            <TabItem Header="Data Editor" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 表选择 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="选择表:" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold" Margin="0,0,10,0"/>
                        <ComboBox x:Name="TableSelectorComboBox" Grid.Column="1"
                                  Height="28" FontSize="12" DisplayMemberPath="FullName"
                                  SelectionChanged="OnTableSelectorSelectionChanged"/>
                        <Button Grid.Column="2" Content="🔄 加载数据" Width="110" Height="28" Margin="10,0,0,0"
                                Click="OnLoadTableDataClick" Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ 添加行" Width="100" Height="28" Margin="0,0,5,0"
                                Click="OnAddRowClick" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="💾 保存更改" Width="110" Height="28" Margin="0,0,5,0"
                                Click="OnSaveRowChangesClick" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="🗑️ 删除行" Width="100" Height="28"
                                Click="OnDeleteRowClick" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <!-- 数据网格 -->
                    <DataGrid x:Name="TableDataDataGrid" Grid.Row="2"
                              AutoGenerateColumns="True" CanUserAddRows="False"
                              GridLinesVisibility="All" HeadersVisibility="Column"
                              HorizontalGridLinesBrush="#DDD" VerticalGridLinesBrush="#EEE"
                              Background="White" BorderBrush="#DDD" BorderThickness="1"
                              FontSize="12" LoadingRow="OnTableDataDataGridLoadingRow"
                              AutoGeneratingColumn="OnTableDataDataGridAutoGeneratingColumn"/>
                </Grid>
            </TabItem>

            <!-- 数据库导出标签页 -->
            <TabItem Header="数据库导出" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 导出选项 -->
                    <GroupBox Grid.Row="0" Header="导出选项" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 格式选择 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="导出格式:"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="0,0,10,5"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                                <RadioButton x:Name="SqlFormatRadioButton" Content="SQL 格式" IsChecked="True"
                                            Margin="0,0,15,0" FontSize="12"/>
                                <RadioButton x:Name="JsonFormatRadioButton" Content="JSON 格式"
                                            Margin="0,0,0,0" FontSize="12"/>
                            </StackPanel>

                            <!-- 导出内容 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="导出内容:"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="0,0,10,5"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                                <CheckBox x:Name="IncludeTablesCheckBox" Content="表结构" IsChecked="True"
                                          Margin="0,0,15,0" FontSize="12"/>
                                <CheckBox x:Name="IncludePoliciesCheckBox" Content="策略" IsChecked="True"
                                          Margin="0,0,15,0" FontSize="12"/>
                                <CheckBox x:Name="IncludeTriggersCheckBox" Content="触发器" IsChecked="True"
                                          Margin="0,0,15,0" FontSize="12"/>
                                <CheckBox x:Name="IncludeIndexesCheckBox" Content="索引" IsChecked="True"
                                          Margin="0,0,15,0" FontSize="12"/>
                                <CheckBox x:Name="IncludeFunctionsCheckBox" Content="函数" IsChecked="True"
                                          Margin="0,0,15,0" FontSize="12"/>
                                <CheckBox x:Name="IncludeViewsCheckBox" Content="视图" IsChecked="True"
                                          Margin="0,0,0,0" FontSize="12"/>
                            </WrapPanel>

                            <!-- 其他选项 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="其他选项:"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="0,0,10,5"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                                <CheckBox x:Name="IncludeDropStatementsCheckBox" Content="包含 DROP 语句"
                                          Margin="0,0,15,0" FontSize="12"/>
                            </StackPanel>

                            <!-- 导出按钮 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ExportButton" Content="📦 导出数据库" Width="130" Height="32"
                                        Click="OnExportDatabaseClick" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 导出进度 -->
                    <GroupBox Grid.Row="1" Header="导出进度" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="ExportStageTextBlock" Text="准备导出..."
                                       FontSize="12" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="1" x:Name="ExportStepTextBlock" Text=""
                                       FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                            <ProgressBar Grid.Row="2" x:Name="ExportProgressBar"
                                         Height="20" Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </GroupBox>

                    <!-- 导出说明 -->
                    <GroupBox Grid.Row="2" Header="导出说明" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock TextWrapping="Wrap" FontSize="11">
                                <Run Text="• SQL 格式：生成完整的 SQL 脚本，包含 CREATE 语句，可直接在数据库中执行" FontWeight="Bold"/><LineBreak/>
                                <Run Text="• JSON 格式：生成结构化的 JSON 文件，包含完整的数据库元数据，便于分析和版本控制"/><LineBreak/>
                                <Run Text="• 导出内容包括：表结构、列信息、主键、外键、索引、策略(RLS)、触发器、函数、视图"/><LineBreak/>
                                <Run Text="• 外键关系会从表结构中自动提取并包含在导出中"/><LineBreak/>
                                <Run Text="• 导出过程使用事务包装，确保数据的完整性"/><LineBreak/>
                            </TextBlock>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#ECECEC" BorderBrush="#CCC" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="ConnectionStatusTextBlock" Text="❌ 未连接" Foreground="#999"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CurrentObjectTextBlock" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"/>
        </StatusBar>
    </Grid>
</Window>
